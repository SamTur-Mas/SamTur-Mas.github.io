---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PaperCard from '../components/PaperCard.astro';
import Search from '../components/Search.astro';

const allPapers = await getCollection('papers', ({ data }) => !data.draft);
const papers = allPapers.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Group papers by month
const grouped = papers.reduce<Record<string, typeof papers>>((acc, paper) => {
  const key = paper.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' });
  if (!acc[key]) acc[key] = [];
  acc[key].push(paper);
  return acc;
}, {});
---

<BaseLayout title="论文笔记">
  <div class="space-y-2 mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-50">论文笔记</h1>
    <p class="text-slate-500 dark:text-slate-400">
      记录每日阅读的论文、分析与感想 · 共 <span class="font-medium text-slate-700 dark:text-slate-300">{papers.length}</span> 篇
    </p>
  </div>

  <Search />

  {Object.entries(grouped).length === 0 ? (
    <div class="text-center py-20 text-slate-400 dark:text-slate-600">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-4 opacity-40">
        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/>
      </svg>
      <p class="text-lg font-medium">还没有论文笔记</p>
      <p class="text-sm mt-1">在 <code class="text-indigo-500">src/content/papers/</code> 目录下创建 .mdx 文件开始记录</p>
    </div>
  ) : (
    <div class="space-y-10">
      {Object.entries(grouped).map(([month, monthPapers]) => (
        <section>
          <h2 class="text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-4 pb-2 border-b border-slate-100 dark:border-slate-800">
            {month}
          </h2>
          <div class="grid gap-3">
            {monthPapers.map(paper => (
              <PaperCard
                title={paper.data.title}
                slug={paper.id}
                date={paper.data.date}
                tldr={paper.data.tldr}
                tags={paper.data.tags}
                rating={paper.data.rating}
                venue={paper.data.venue}
                arxiv={paper.data.arxiv}
              />
            ))}
          </div>
        </section>
      ))}
    </div>
  )}
</BaseLayout>
