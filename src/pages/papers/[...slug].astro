---
import { getCollection, render } from 'astro:content';
import PaperLayout from '../../layouts/PaperLayout.astro';

export async function getStaticPaths() {
  const papers = await getCollection('papers', ({ data }) => !data.draft);
  return papers.map(paper => ({
    params: { slug: paper.id },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const { Content } = await render(paper);
---

<PaperLayout
  title={paper.data.title}
  date={paper.data.date}
  tldr={paper.data.tldr}
  tags={paper.data.tags}
  rating={paper.data.rating}
  venue={paper.data.venue}
  arxiv={paper.data.arxiv}
  authors={paper.data.authors}
>
  <Content />
</PaperLayout>
