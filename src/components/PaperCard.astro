---
import TagBadge from './TagBadge.astro';
import RatingStars from './RatingStars.astro';

interface Props {
  title: string;
  slug: string;
  date: Date;
  tldr?: string;
  tags: string[];
  rating?: number;
  venue?: string;
  arxiv?: string;
}

const { title, slug, date, tldr, tags, rating, venue, arxiv } = Astro.props;

const formattedDate = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<article class="group bg-white dark:bg-slate-800/50 rounded-xl border border-slate-200 dark:border-slate-700 p-5 hover:shadow-md hover:border-indigo-300 dark:hover:border-indigo-700 transition-all duration-200">
  <div class="flex items-start justify-between gap-3 mb-2">
    <div class="flex items-center gap-2 text-xs text-slate-400 dark:text-slate-500 flex-wrap">
      <time datetime={date.toISOString()}>{formattedDate}</time>
      {venue && (
        <span class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-medium">
          {venue}
        </span>
      )}
      {arxiv && (
        <a
          href={`https://arxiv.org/abs/${arxiv}`}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-indigo-500 transition-colors"
          onclick="event.stopPropagation()"
        >
          arXiv:{arxiv}
        </a>
      )}
    </div>
    {rating && <RatingStars rating={rating} />}
  </div>

  <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-100 mb-2 leading-snug group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
    <a href={`/papers/${slug}/`} class="stretched-link after:absolute after:inset-0">
      {title}
    </a>
  </h2>

  {tldr && (
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-3 line-clamp-2 leading-relaxed">
      {tldr}
    </p>
  )}

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 relative z-10">
      {tags.map(tag => <TagBadge tag={tag} />)}
    </div>
  )}
</article>
