---
interface Props {
  rating: number;
}
const { rating } = Astro.props;
---
<span class="inline-flex gap-0.5" aria-label={`Rating: ${rating} out of 5`}>
  {Array.from({ length: 5 }, (_, i) => (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill={i < rating ? 'currentColor' : 'none'}
      stroke="currentColor"
      stroke-width="2"
      class={i < rating ? 'text-amber-400' : 'text-slate-300 dark:text-slate-600'}
    >
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
    </svg>
  ))}
</span>
